 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 01_eda.ipynb — Titanic exploratory data analysis\n",
    "\n",
    "This notebook loads the Titanic dataset (using seaborn.load_dataset exactly once), saves it to `titanic.csv`, and performs the EDA steps required: info/describe/shape, missingness analysis and rule-based handling, visualizations, correlation heatmap, z-score checks, and several story charts with Markdown placeholders for interpretation.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Load libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy import stats\n",
    "\n",
    "sns.set(style=\"whitegrid\")\n",
    "\n",
    "# Load the titanic dataset exactly once and save to CSV as required\n",
    "df = sns.load_dataset('titanic')\n",
    "df.to_csv('titanic.csv', index=False)\n",
    "print('Saved titanic.csv with shape:', df.shape)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Basic information and summaries"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# df.info() equivalent printed summary\n",
    "print('DF shape:', df.shape)\n",
    "print('\nDF dtypes:\n', df.dtypes)\n",
    "print('\nDescribe (numeric columns):')\n",
    "print(df.describe(include='all'))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Missingness and rule application"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Missing percent per column\n",
    "missing_pct = df.isna().mean() * 100\n",
    "missing_pct = missing_pct[missing_pct > 0]  # only those with any missing\n",
    "print('Missing percentages (columns with any missing):')\n",
    "print(missing_pct)\n",
    "\n",
    "# Apply rules: <5% drop rows; 5-30% impute; >30% drop column or use 'Missing' category\n",
    "actions = {}\n",
    "n = len(df)\n",
    "for col, pct in missing_pct.items():\n",
    "    if pct < 5:\n",
    "        actions[col] = 'drop-rows'\n",
    "    elif pct <= 30:\n",
    "        actions[col] = 'impute'\n",
    "    else:\n",
    "        actions[col] = 'drop-or-missing-cat'\n",
    "print('\nApplied missingness rules:')\n",
    "print(pd.Series(actions))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Age and Fare distributions, outliers, and z-score checks"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "for col in ['age','fare']:\n",
    "    series = df[col].dropna()\n",
    "    q1 = series.quantile(0.25)\n",
    "    q3 = series.quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    lower = q1 - 1.5 * iqr\n",
    "    upper = q3 + 1.5 * iqr\n",
    "    outliers = series[(series < lower) | (series > upper)]\n",
    "    print(f"\nColumn: {col}")\n",
    "    print(f"IQR: {iqr:.3f}, outliers count: {len(outliers)}")\n",
    "    plt.figure(figsize=(10,4))\n",
    "    plt.subplot(1,2,1)\n",
    "    sns.histplot(series, kde=True)\n",
    "    plt.title(f'{col} histogram')\n",
    "    plt.subplot(1,2,2)\n",
    "    sns.boxplot(x=series)\n",
    "    plt.title(f'{col} boxplot')\n",
    "    plt.show()\n",
    "\n",
    "# mean/median/mode of fare and skew conclusion\n",
    "fare = df['fare'].dropna()\n",
    "print('\nFare mean:', fare.mean(), 'median:', fare.median(), 'mode:', fare.mode().iloc[0])\n",
    "print('Skew (pearson):', stats.skew(fare.dropna()))\n",
    "\n",
    "# z-score standardization check for age and fare\n",
    "for col in ['age','fare']:\n",
    "    vals = df[col].dropna()\n",
    "    z = (vals - vals.mean()) / vals.std(ddof=0)\n",
    "    print(f"\nZ-score check for {col}: mean {z.mean():.3f}, std {z.std(ddof=0):.3f}")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Survival rates by sex, pclass, and combined sex+pclass"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "print('Survival rate overall:', df['survived'].mean())\n",
    "print('\nSurvival by sex:')\n",
    "print(df.groupby('sex')['survived'].mean())\n",
    "print('\nSurvival by pclass:')\n",
    "print(df.groupby('pclass')['survived'].mean())\n",
    "print('\nSurvival by sex and pclass:')\n",
    "print(df.groupby(['sex','pclass'])['survived'].mean())\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Correlation heatmap and top pairs"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "corr_cols = ['survived','pclass','age','sibsp','parch','fare']\n",
    "corr = df[corr_cols].corr().abs()\n",
    "plt.figure(figsize=(8,6))\n",
    "sns.heatmap(corr, annot=True, cmap='coolwarm')\n",
    "plt.title('Absolute correlation matrix')\n",
    "plt.show()\n",
    "# find top two pairs by absolute correlation (excluding self-pairs)\n",
    "pairs = []\n",
    "for i in range(len(corr_cols)):\n",
    "    for j in range(i+1, len(corr_cols)):\n",
    "        pairs.append(((corr_cols[i], corr_cols[j]), corr.iloc[i,j]))\n",
    "pairs_sorted = sorted(pairs, key=lambda x: x[1], reverse=True)\n",
    "print('\nTop two pairs by absolute correlation:')\n",
    "for p,v in pairs_sorted[:2]:\n",
    "    print(p, v)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
