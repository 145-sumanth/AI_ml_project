FROM python:3.11-slim

# Lightweight build: do NOT pre-download the embedding model or run ingestion at build time.
# This makes the image build much faster and moves the model download to a controlled run-time step.
WORKDIR /app

# Copy module and requirements
COPY support_assistant /app/support_assistant
COPY support_assistant/requirements.txt /app/support_assistant/requirements.txt
COPY support_assistant/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Install system deps and Python requirements
RUN apt-get update && apt-get install -y --no-install-recommends gcc build-essential libpq-dev curl \
    && python -m pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /app/support_assistant/requirements.txt \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 7860

# Entrypoint runs optional ingestion if RUN_INGEST=1, then starts the API.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "support_assistant.main:app", "--host", "0.0.0.0", "--port", "7860"]
